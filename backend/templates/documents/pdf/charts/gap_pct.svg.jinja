{# Macro SVG: gráfico de gap % al P1 por válida
   Inputs:
     points — lista de {x: valida_num, y: gap_pct|null}
     width / height / low_confidence
#}
{% macro gap_pct(points, width=420, height=180, low_confidence=false) %}
{%- set valid_points = points | selectattr("y", "ne", none) | list -%}
{%- set pad_left = 45 -%}
{%- set pad_right = 20 -%}
{%- set pad_top = 20 -%}
{%- set pad_bottom = 30 -%}
{%- set chart_w = width - pad_left - pad_right -%}
{%- set chart_h = height - pad_top - pad_bottom -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}" role="img" aria-label="Gap al P1 por válida (%)">
  <title>Gap al P1 (%)</title>
  <rect x="0" y="0" width="{{ width }}" height="{{ height }}" fill="#f9f9f9" rx="4"/>
  <rect x="{{ pad_left }}" y="{{ pad_top }}" width="{{ chart_w }}" height="{{ chart_h }}" fill="white" stroke="#e0e0e0"/>
  {%- if valid_points | length > 0 -%}
    {%- set max_y = valid_points | map(attribute="y") | max -%}
    {%- set max_y = [max_y, 5] | max -%}
    {%- set min_x = valid_points | map(attribute="x") | min -%}
    {%- set max_x = valid_points | map(attribute="x") | max -%}
    {%- set x_range = [(max_x - min_x), 1] | max -%}
    <!-- Línea 0% (P1) -->
    <line x1="{{ pad_left }}" y1="{{ pad_top }}" x2="{{ pad_left + chart_w }}" y2="{{ pad_top }}" stroke="#22c55e" stroke-dasharray="3,2" stroke-width="1" opacity="0.6"/>
    <text x="{{ pad_left + 2 }}" y="{{ pad_top + 9 }}" font-size="7" fill="#15803d">P1=0%</text>
    {%- set prev_cx = namespace(val=none) -%}
    {%- set prev_cy = namespace(val=none) -%}
    {%- for pt in valid_points -%}
      {%- set cx = pad_left + ((pt.x - min_x) / x_range) * chart_w -%}
      {%- set cy = pad_top + (pt.y / max_y) * chart_h -%}
      {%- if prev_cx.val is not none -%}
        <line x1="{{ prev_cx.val }}" y1="{{ prev_cy.val }}" x2="{{ cx }}" y2="{{ cy }}" stroke="#dc2626" stroke-width="2"/>
      {%- endif -%}
      <circle cx="{{ cx }}" cy="{{ cy }}" r="4" fill="#dc2626"/>
      <text x="{{ cx }}" y="{{ cy - 5 }}" text-anchor="middle" font-size="8" fill="#991b1b">{{ "%.1f"|format(pt.y) }}%</text>
      <text x="{{ cx }}" y="{{ pad_top + chart_h + 12 }}" text-anchor="middle" font-size="8" fill="#555">V{{ pt.x }}</text>
      {%- set prev_cx.val = cx -%}
      {%- set prev_cy.val = cy -%}
    {%- endfor -%}
    <!-- Etiqueta Y -->
    <text x="{{ pad_left - 3 }}" y="{{ pad_top + chart_h }}" text-anchor="end" font-size="8" fill="#666">{{ "%.0f"|format(max_y) }}%</text>
  {%- else -%}
    <text x="{{ width / 2 }}" y="{{ height / 2 }}" text-anchor="middle" font-size="11" fill="#999">Sin datos</text>
  {%- endif -%}
  {%- if low_confidence -%}
    <rect x="{{ width - 110 }}" y="4" width="106" height="14" rx="3" fill="#fef3c7"/>
    <text x="{{ width - 57 }}" y="14" text-anchor="middle" font-size="8" fill="#92400e">Confianza baja</text>
  {%- endif -%}
  <text x="{{ pad_left }}" y="13" font-size="9" fill="#374151" font-weight="bold">Gap al P1 (%)</text>
</svg>
{% endmacro %}
