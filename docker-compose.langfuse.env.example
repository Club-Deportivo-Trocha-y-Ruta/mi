# =============================================================================
# Variables de entorno para docker-compose.langfuse.yml (Langfuse v4)
# =============================================================================
# Uso:
#   1) cp docker-compose.langfuse.env.example docker-compose.langfuse.env
#   2) Generar los secretos abajo y reemplazarlos
#   3) docker compose -f docker-compose.langfuse.yml --env-file docker-compose.langfuse.env up -d
#
# IMPORTANTE: Este archivo NO debe commitearse. Asegúrate de que
# docker-compose.langfuse.env esté en .gitignore (este .env.example sí se commitea).
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETOS - generar localmente y NUNCA reusar de prod
# -----------------------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=REEMPLAZAR_CON_openssl_rand_base64_32

# openssl rand -base64 32
SALT=REEMPLAZAR_CON_openssl_rand_base64_32

# openssl rand -hex 32   (exactamente 64 caracteres hex)
ENCRYPTION_KEY=REEMPLAZAR_CON_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# URL pública de la UI (lo que el browser ve)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Credenciales internas - OK dejarlas así en dev local
# -----------------------------------------------------------------------------
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse_dev_pwd
POSTGRES_DB=langfuse

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse_dev_pwd

REDIS_AUTH=redis_dev_pwd

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_pwd

# -----------------------------------------------------------------------------
# Bootstrap headless del primer org/proyecto/usuario (se crea solo si la DB
# está vacía). v4 exige *_ID además de *_NAME, y el par de llaves API del
# proyecto (así la UI no hay que abrirla para generarlas).
# -----------------------------------------------------------------------------
LANGFUSE_INIT_ORG_ID=trocha-y-ruta
LANGFUSE_INIT_ORG_NAME="Trocha y Ruta"
LANGFUSE_INIT_PROJECT_ID=race-analyst-dev
LANGFUSE_INIT_PROJECT_NAME=race-analyst-dev

# Llave pública del proyecto: prefijo "pk-lf-" + openssl rand -hex 16
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REEMPLAZAR_CON_openssl_rand_hex_16
# Llave secreta del proyecto: prefijo "sk-lf-" + openssl rand -hex 24
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REEMPLAZAR_CON_openssl_rand_hex_24

LANGFUSE_INIT_USER_EMAIL=coach@trochayruta.local
LANGFUSE_INIT_USER_NAME="Coach Dev"
LANGFUSE_INIT_USER_PASSWORD=ChangeMe2026!

# -----------------------------------------------------------------------------
# El backend lee este MISMO par de llaves (LANGFUSE_PUBLIC_KEY / SECRET_KEY en
# su propio .env) para autenticar contra el proyecto creado arriba.
# -----------------------------------------------------------------------------
