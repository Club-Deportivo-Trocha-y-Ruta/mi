# === Base de datos ===
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=trocha
MYSQL_PASS=changeme
MYSQL_DB=trocha_ruta
MYSQL_ROOT_PASS=rootchangeme

# === JWT ===
JWT_SECRET_KEY=cambiar-en-produccion-con-valor-seguro
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === App ===
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Email / Notificaciones ===
# Proveedor: smtp (dev con MailHog) | resend (prod)
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@trochyruta.com
EMAIL_FROM_NAME=Club Trocha y Ruta

# SMTP (dev — apunta a MailHog en Docker)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Resend (prod — obtener en resend.com/api-keys)
RESEND_API_KEY=re_CHANGE_ME
# Secreto de firma Svix del webhook de Resend (feature 038, P3). Vacío =
# router /api/webhooks/resend responde 404 (feature apagada, opt-in).
RESEND_WEBHOOK_SECRET=

# Control de envío
# false = silencia todos los emails sin cambiar código (útil en staging/tests)
NOTIFICATION_SEND_EMAILS=true
# false = no loguear body de emails (requerido en prod por privacidad de menores)
NOTIFICATION_LOG_BODIES=false

# === IA / LLMs ===
# false = la capa de IA está apagada y la factoría devuelve FakeLLMProvider.
AI_ENABLED=false
# Proveedor: anthropic | openai | google | fake | claude-cli
#   claude-cli = SOLO desarrollo local: usa la suscripción Claude del
#                desarrollador a través del Claude Code CLI ya logueado en la
#                máquina (sin API key). Requiere `pip install langchain-claude-cli`.
#                No usar en Render: los términos de consumo de Anthropic no
#                permiten servir usuarios finales con una suscripción personal.
# Este es el ÚNICO lugar que hace falta cambiar para mover TODO el proyecto
# (análisis de carreras + newsletter/asistente/PHV) a otro proveedor en
# local — RACE_AI_PROVIDER (abajo) hereda este valor cuando queda vacío.
AI_PROVIDER=google
# Modelo del proveedor. Con claude-cli: claude-sonnet-5.
AI_MODEL=gemini-3.1-flash-lite
# API key del proveedor — NUNCA con default real, NUNCA en repo. claude-cli
# la ignora (usa el login OAuth del CLI).
AI_API_KEY=
# Override opcional del endpoint (proxy, gateway corporativo, etc.).
# Para Ollama local: AI_PROVIDER=openai, AI_MODEL=<modelo ollama>,
# AI_API_KEY=ollama (dummy), AI_BASE_URL=http://host.docker.internal:11434/v1
AI_BASE_URL=
# Tope de tokens de salida por respuesta — control de costos
# 8192 requerido por race-results v2 agentico (insight + recomendaciones + citas RAG)
AI_MAX_TOKENS=8192
# Timeout por request (segundos)
AI_TIMEOUT_SECONDS=30
# Temperatura — 0.4 razonable para explicaciones técnicas a padres
AI_TEMPERATURE=0.4
# false = no loguear prompts ni respuestas (OBLIGATORIO en prod por privacidad)
AI_LOG_PROMPTS=false

# === Race AI — proveedor/modelo dedicado (race/agents/), opcional ===
# El pipeline agéntico de análisis de carreras (analyst/critic/chat) PUEDE
# correr con un proveedor/modelo/API key distinto de AI_PROVIDER/AI_MODEL de
# arriba (ej. un modelo más barato para el volumen de carreras) — pero por
# defecto vacío = HEREDA AI_PROVIDER. No hace falta tocar nada aquí para
# que el análisis de carreras use el mismo proveedor que el resto del
# proyecto. Proveedor: "" (hereda) | anthropic | google | openai | claude-cli
RACE_AI_PROVIDER=
# Vacío = default por proveedor (claude-sonnet-5 | gemini-3.1-flash-lite | gpt-4o-mini)
RACE_AI_MODEL=
# Vacío = si el proveedor efectivo == AI_PROVIDER, reusa AI_API_KEY (claude-cli la ignora)
RACE_AI_API_KEY=
# base_url del proveedor race (solo openai): Ollama = http://host.docker.internal:11434/v1
RACE_AI_BASE_URL=
# Modelos por rol (analyst fuerte, critic barato) — override real, no
# duplican AI_PROVIDER. Con claude-cli, usar modelos Claude:
#   RACE_AI_ANALYST_MODEL=claude-sonnet-5
#   RACE_AI_CRITIC_MODEL=claude-haiku-4-5-20251001
# Sin definir = defaults de config.py (gemini-3.8-flash / gemini-3.1-flash-lite).
# No dejarlas vacías si el proveedor efectivo no es Gemini: una variable
# vacía pisa el default (que sí asume Gemini).
# RACE_AI_ANALYST_MODEL=
# RACE_AI_CRITIC_MODEL=
# claude-cli dentro de Docker: INSTALL_CLAUDE_CLI=true instala el paquete en la
# imagen LOCAL (Render construye con el mismo Dockerfile pero no recibe este
# build arg). El token lo genera cada desarrollador en su propia terminal con
# `claude setup-token`; el uvicorn del host usa el Keychain y no lo necesita.
INSTALL_CLAUDE_CLI=false
CLAUDE_CODE_OAUTH_TOKEN=

# === Langfuse — trazas LLM del pipeline race (SOLO desarrollo local) ===
# Tokens/modelo por llamada LLM en un Langfuse self-hosted. PROHIBIDO en
# producción (Settings falla al arrancar). Levantar Langfuse con:
#   docker compose -f docker-compose.langfuse.yml --env-file docker-compose.langfuse.env up -d
# Las llaves son LANGFUSE_INIT_PROJECT_PUBLIC_KEY / LANGFUSE_INIT_PROJECT_SECRET_KEY
# de docker-compose.langfuse.env. Base URL para uvicorn en el host: http://localhost:3001
# LANGFUSE_ENABLED=false
# LANGFUSE_BASE_URL=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Input/output/metadata de las trazas van siempre como "[redacted]": solo se
# ven modelo, tokens, latencia y la estructura de la corrida.

# === Media de sesiones (Hostinger SFTP) ===
# Si quedan vacíos, el backend usa fallback local en static/uploads/media
# (útil sólo en dev — en prod usar SFTP a Hostinger para persistencia).
HOSTINGER_SFTP_HOST=
HOSTINGER_SFTP_PORT=22
HOSTINGER_SFTP_USER=
HOSTINGER_SFTP_PASS=
HOSTINGER_SFTP_REMOTE_DIR=/home/uXXXXX/public_html/media
HOSTINGER_PUBLIC_BASE_URL=https://trochyruta.com/media

# Límites de media (en MB)
MEDIA_MAX_PHOTO_MB=10
MEDIA_MAX_VIDEO_MB=50

# === Race results upload (F-UP wizard) ===
# Límite tamaño PDF/CSV por archivo (MB). Render free tier limita ~8 MB request body.
RACE_MAX_PDF_MB=8
# Timeout parseo pdfplumber (segundos). Render cold start +50s, esto cubre warm.
RACE_PARSE_TIMEOUT_SECONDS=30
# TTL para RaceImport en status=pending sin commit (horas). Cleanup nocturno barre.
RACE_PENDING_TTL_HOURS=24

# === Restablecimiento de contraseña (specs/003-password-reset-login) ===
# Vigencia del enlace de restablecimiento (minutos). OWASP: rara vez > 60.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Máximo de solicitudes por correo dentro de la ventana (anti-flooding).
PASSWORD_RESET_MAX_PER_WINDOW=3
# Ventana móvil (minutos) para el conteo de rate-limit por correo.
PASSWORD_RESET_WINDOW_MINUTES=15

# === Strava Activity Sync (specs/025-strava-activity-sync) ===
# Master switch; disables all Strava endpoints when false
STRAVA_ENABLED=false
# Strava OAuth app credentials (obtain from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Webhook subscription verification token (any random string; used on Strava subscription handshake)
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Fernet encryption key for encrypting/decrypting access + refresh tokens at rest
# Generation: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRAVA_TOKEN_ENCRYPTION_KEY=
# Shared secret token for reconcile job (POST /api/integrations/strava/reconcile)
# Generation: openssl rand -hex 32
STRAVA_RECONCILE_TOKEN=
# Strava API base URL (switch to https://api-v3.strava.com before 2027-01-04)
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
# Strava OAuth base URL
STRAVA_OAUTH_BASE_URL=https://www.strava.com/oauth
# OAuth callback URL — MUST match this backend's host and the "Authorization
# Callback Domain" configured in the Strava app dashboard (NOT the frontend).
# Default below is dev-only; production MUST override it (validator enforces).
STRAVA_REDIRECT_URI=http://localhost:8000/api/integrations/strava/callback
# Reconcile job lookback window (hours) — margin for catching late-arriving activities
STRAVA_RECONCILE_LOOKBACK_HOURS=48
